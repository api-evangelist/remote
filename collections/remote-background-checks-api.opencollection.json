{
  "opencollection": "1.0.0",
  "info": {
    "name": "Remote Address Details Background Checks API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/auth/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Background Checks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Show Background Check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/employments/:employment_id/background-checks/:background_check_id",
            "params": [
              {
                "name": "employment_id",
                "value": "31b8e49b-aa1c-47af-849c-3d0a53e20e0d",
                "type": "path",
                "description": "Employment Id"
              },
              {
                "name": "background_check_id",
                "value": "31b8e49b-aa1c-47af-849c-3d0a53e20e0d",
                "type": "path",
                "description": "Background Check Id"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "/auth/oauth2/authorize",
              "accessTokenUrl": "/auth/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Show Background Check details for a given employment and background check request.\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage employments (`employments`) | View background checks (`background_check:read`) | - |\n"
        }
      ]
    }
  ],
  "bundled": true
}