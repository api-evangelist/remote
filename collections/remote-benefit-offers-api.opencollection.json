{
  "opencollection": "1.0.0",
  "info": {
    "name": "Remote Address Details Benefit Offers API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/auth/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Benefit Offers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get employment benefit offers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/employments/:employment_id/benefit-offers",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Starts fetching records after the given page"
              },
              {
                "name": "page_size",
                "value": "20",
                "type": "query",
                "description": "Number of items per page"
              },
              {
                "name": "employment_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the employment"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage company resources (`company_admin`) | View benefit offers (`benefit_offer:read`) | Manage benefit offers (`benefit_offer:write`) |\n"
        },
        {
          "info": {
            "name": "Upserts employment benefit offers",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://gateway.remote.com/v1/employments/:employment_id/benefit-offers",
            "params": [
              {
                "name": "employment_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the employment"
              },
              {
                "name": "json_schema_version",
                "value": "1",
                "type": "query",
                "description": "Version of the form schema"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Upserts employment benefit offers"
        },
        {
          "info": {
            "name": "Get a employment benefit offers JSON schema",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/employments/:employment_id/benefit-offers/schema",
            "params": [
              {
                "name": "employment_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the employment"
              },
              {
                "name": "json_schema_version",
                "value": "1",
                "type": "query",
                "description": "Version of the form schema"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage company resources (`company_admin`) | View benefit offers (`benefit_offer:read`) | Manage benefit offers (`benefit_offer:write`) |\n"
        },
        {
          "info": {
            "name": "List Benefit Offers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/benefit-offers/country-summaries",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer <COMPANY-SCOPED ACCESS TOKEN>"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List benefit offers for each country.\n\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage company resources (`company_admin`) | View benefit offers (`benefit_offer:read`) | Manage benefit offers (`benefit_offer:write`) |\n"
        }
      ]
    }
  ],
  "bundled": true
}