              "query": [
                {
                  "disabled": false,
                  "key": "billing_address_details_json_schema_version",
                  "value": "<integer>",
                  "description": "Version of the billing_address_details form schema"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "employment_id",
                  "description": "(Required) Employment ID"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
