{
  "opencollection": "1.0.0",
  "info": {
    "name": "Remote Address Details Contract Documents API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/auth/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Contract Documents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Return a base64 encoded version of the contract document",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/contractors/employments/:employment_id/contract-documents/:id",
            "params": [
              {
                "name": "employment_id",
                "value": "93t3j-file-id-9suej43",
                "type": "path",
                "description": "Employment ID"
              },
              {
                "name": "id",
                "value": "93t3j-file-id-9suej43",
                "type": "path",
                "description": "Document ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage employment documents (`employment_documents`) | View documents (`document:read`) | Manage documents (`document:write`) |\n"
        },
        {
          "info": {
            "name": "Create a contract document for a contractor",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://gateway.remote.com/v1/contractors/employments/:employment_id/contract-documents",
            "params": [
              {
                "name": "employment_id",
                "value": "1a716003-ae89-4810-aa00-25df6e799162",
                "type": "path",
                "description": "Employment ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a contract document for a contractor.\n\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage employment documents (`employment_documents`) | - | Manage documents (`document:write`) |\n"
        },
        {
          "info": {
            "name": "Sign a document for a contractor",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://gateway.remote.com/v1/contractors/employments/:employment_id/contract-documents/:contract_document_id/sign",
            "params": [
              {
                "name": "employment_id",
                "value": "93t3j-file-id-9suej43",
                "type": "path",
                "description": "Employment ID"
              },
              {
                "name": "contract_document_id",
                "value": "93t3j-file-id-9suej43",
                "type": "path",
                "description": "Document ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage employment documents (`employment_documents`) | - | Manage documents (`document:write`) |\n"
        }
      ]
    }
  ],
  "bundled": true
}