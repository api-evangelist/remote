{
  "opencollection": "1.0.0",
  "info": {
    "name": "Remote Address Details Contract Eligibility API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/auth/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Contract Eligibility",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create contract eligibility",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://gateway.remote.com/v1/employments/:employment_id/contract-eligibility",
            "params": [
              {
                "name": "employment_id",
                "value": "31b8e49b-aa1c-47af-849c-3d0a53e20e0d",
                "type": "path",
                "description": "Employment ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create contract eligibility for an employment.\n\nThis will create a new contract eligibility for the employment.\n\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage employment documents (`employment_documents`) | - | Manage contract eligibility (`contract_eligibility:write`) |\n"
        }
      ]
    }
  ],
  "bundled": true
}