                "employments",
                ":employment_id",
                "contract-eligibility"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "employment_id",
                  "description": "(Required) Employment ID"
                }
