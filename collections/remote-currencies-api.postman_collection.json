          "name": "List all currencies for the contractor",
          "request": {
            "name": "List all currencies for the contractor",
            "description": {
              "content": "The currencies are listed in the following order:\n1. billing currency of the company\n2. currencies of contractor’s existing withdrawal methods\n3. currency of the contractor’s country\n4. the rest, alphabetical.\n\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage employments (`employments`) | View employments (`employment:read`) | Manage employments (`employment:write`) |\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "contractors",
                "employments",
                ":employment_id",
                "contractor-currencies"
              ],
              "host": [
                "{{baseUrl}}"
              ],
