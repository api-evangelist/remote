{
  "opencollection": "1.0.0",
  "info": {
    "name": "Remote Address Details Employee Documents API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/auth/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Employee Documents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Download a document for the employee",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/employee/documents/:id",
            "params": [
              {
                "name": "id",
                "value": "93t3j-file-id-9suej43",
                "type": "path",
                "description": "Document ID"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/auth/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage employment documents (`employment_documents`) | View documents (`document:read`) | Manage documents (`document:write`) |\n"
        },
        {
          "info": {
            "name": "Indexes all the documents for the employee",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/employee/documents",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Starts fetching records after the given page"
              },
              {
                "name": "page_size",
                "value": "20",
                "type": "query",
                "description": "Number of items per page"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter documents by their description or file name, accepts full and partial case insensitive matches"
              },
              {
                "name": "inserted_after",
                "value": "",
                "type": "query",
                "description": "Filters the results that were uploaded on or after a given date"
              },
              {
                "name": "inserted_before",
                "value": "",
                "type": "query",
                "description": "Filters the results that were uploaded before a given date"
              },
              {
                "name": "sort_by",
                "value": "description",
                "type": "query",
                "description": "Field to sort by"
              },
              {
                "name": "order",
                "value": "asc",
                "type": "query",
                "description": "Sort order"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/auth/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage employment documents (`employment_documents`) | View documents (`document:read`) | Manage documents (`document:write`) |\n"
        }
      ]
    }
  ],
  "bundled": true
}