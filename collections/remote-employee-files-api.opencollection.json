{
  "opencollection": "1.0.0",
  "info": {
    "name": "Remote Address Details Employee Files API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/auth/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Employee Files",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Upload employee file",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://gateway.remote.com/v1/employee/documents",
            "body": {
              "type": "multipart-form",
              "data": []
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/auth/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Uploads a file owned by the authenticated employee, for example\nidentity documents or tax forms.\n\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage employment documents (`employment_documents`) | - | Manage documents (`document:write`) |\n"
        }
      ]
    }
  ],
  "bundled": true
}