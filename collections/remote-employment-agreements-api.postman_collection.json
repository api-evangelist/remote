          "id": "b5537bca-0f52-42eb-a264-65a4b376a3e8",
          "name": "Download the Employment Agreement for an employment",
          "request": {
            "name": "Download the Employment Agreement for an employment",
            "description": {
              "content": "Downloads a PDF of the auto-generated Employment Agreement for an employment.\n\nThe document is rendered as a draft (no signatures) and is not persisted. EA preview is only\navailable for countries that have a published Employment Agreement automation template — see the\n`employment_agreement_preview_available` flag on the [Countries](#tag/Countries) endpoint.\n\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage employment documents (`employment_documents`) | View documents (`document:read`) | Manage documents (`document:write`) |\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "employments",
                ":employment_id",
                "employment-agreement",
                "download"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "employment_id",
                  "description": "(Required) Employment ID"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
