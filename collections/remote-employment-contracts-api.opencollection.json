{
  "opencollection": "1.0.0",
  "info": {
    "name": "Remote Address Details Employment Contracts API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/auth/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Employment Contracts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List contract documents for an employment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/employments/:employment_id/contract-documents",
            "params": [
              {
                "name": "employment_id",
                "value": "1a716003-ae89-4810-aa00-25df6e799162",
                "type": "path",
                "description": "Employment ID"
              },
              {
                "name": "statuses",
                "value": "finished,awaiting_signatures",
                "type": "query",
                "description": "Filter by contract document statuses"
              },
              {
                "name": "except_statuses",
                "value": "draft",
                "type": "query",
                "description": "Exclude contract documents with specific statuses"
              },
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Starts fetching records after the given page"
              },
              {
                "name": "page_size",
                "value": "20",
                "type": "query",
                "description": "Number of items per page"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Only contractor employment types are supported. Lists contract documents for a specific employment with pagination, filtering by status, and sorted by updated_at descending (latest first).\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage employment documents (`employment_documents`) | View documents (`document:read`) | Manage documents (`document:write`) |\n"
        },
        {
          "info": {
            "name": "Get employment contract pending changes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/employment-contracts/:employment_id/pending-changes",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer <COMPANY-SCOPED ACCESS TOKEN>"
              }
            ],
            "params": [
              {
                "name": "employment_id",
                "value": "93t3j-employment_id-9suej43",
                "type": "path",
                "description": "Employment ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all the pending changes (waiting for aproval or signature) for the employment contract.\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage employments (`employments`) | View contracts (`contract:read`) | - |\n"
        },
        {
          "info": {
            "name": "List Employment Contract.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/employment-contracts",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer <COMPANY-SCOPED ACCESS TOKEN>"
              }
            ],
            "params": [
              {
                "name": "employment_id",
                "value": "93t3j-employment_id-9suej43",
                "type": "query",
                "description": "Employment ID"
              },
              {
                "name": "only_active",
                "value": "false",
                "type": "query",
                "description": "Only Active"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get the employment contract history for a given employment. If `only_active` is true, it will return only the active or last active contract.\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage employments (`employments`) | View contracts (`contract:read`) | - |\n"
        }
      ]
    }
  ],
  "bundled": true
}