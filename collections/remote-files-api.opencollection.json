{
  "opencollection": "1.0.0",
  "info": {
    "name": "Remote Address Details Files API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/auth/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Files",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Download file",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/files/:id",
            "params": [
              {
                "name": "id",
                "value": "93t3j-file-id-9suej43",
                "type": "path",
                "description": "File ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Downloads a file.\n\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage employment documents (`employment_documents`) | View documents (`document:read`) | Manage documents (`document:write`) |\n"
        },
        {
          "info": {
            "name": "List employment files",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/employments/:employment_id/files",
            "params": [
              {
                "name": "employment_id",
                "value": "emp-123456",
                "type": "path",
                "description": "Employment ID"
              },
              {
                "name": "type",
                "value": "contract",
                "type": "query",
                "description": "Filter by file type (optional)"
              },
              {
                "name": "sub_type",
                "value": "personal_id",
                "type": "query",
                "description": "Filter by file sub_type (optional)"
              },
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Starts fetching records after the given page"
              },
              {
                "name": "page_size",
                "value": "20",
                "type": "query",
                "description": "Number of items per page"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists files associated with a specific employment.\n\nSupports filtering by file type and sub_type.\n\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage employment documents (`employment_documents`) | View documents (`document:read`) | Manage documents (`document:write`) |\n"
        },
        {
          "info": {
            "name": "Upload file",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://gateway.remote.com/v1/documents",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer <ANY ACCESS TOKEN>"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": []
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Uploads a file associated with a specified employment.\n\nPlease contact api-support@remote.com to request access to this endpoint.\n\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage employment documents (`employment_documents`) | - | Manage documents (`document:write`) |\n"
        }
      ]
    }
  ],
  "bundled": true
}