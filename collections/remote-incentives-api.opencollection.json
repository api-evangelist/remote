              }
            }
          },
          "docs": "Returns all incentives for the authenticated employee.\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage expenses (`employment_payments`) | View incentives (`incentive:read`) | Manage incentives (`incentive:write`) |\n"
        },
        {
          "info": {
            "name": "List Incentives",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/incentives",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer <COMPANY-SCOPED ACCESS TOKEN>"
              }
            ],
            "params": [
              {
                "name": "employment_id",
                "value": "93t3j-employment-id-9suej43",
                "type": "query",
                "description": "Filter by Employment ID"
              },
              {
                "name": "status",
                "value": "paid",
                "type": "query",
                "description": "Filter by Incentive status"
              },
              {
                "name": "recurring_incentive_id",
                "value": "2f900aaf-4952-4ec4-ac7c-2b917a2b4da9",
                "type": "query",
                "description": "Filter by Recurring Incentive id"
              },
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Starts fetching records after the given page"
              },
              {
                "name": "page_size",
                "value": "30",
                "type": "query",
                "description": "Change the amount of records returned per page, defaults to 20, limited to 100"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists all Incentives of a company\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage expenses (`employment_payments`) | View incentives (`incentive:read`) | Manage incentives (`incentive:write`) |\n"
        },
