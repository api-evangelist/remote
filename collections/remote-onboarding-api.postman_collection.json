          "name": "Show onboarding steps for an employment",
          "request": {
            "name": "Show onboarding steps for an employment",
            "description": {
              "content": "Returns onboarding steps and substeps in a hierarchical, ordered structure.\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage employments (`employments`) | View employments (`employment:read`) | Manage employments (`employment:write`) |\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "employments",
                ":employment_id",
                "onboarding-steps"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "employment_id",
                  "description": "(Required) Employment ID"
                }
              ]
            },
