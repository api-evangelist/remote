{
  "opencollection": "1.0.0",
  "info": {
    "name": "Remote Address Details Org Structure API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/auth/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Org Structure",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List company structure nodes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/employments/:employment_id/company-structure-nodes",
            "params": [
              {
                "name": "employment_id",
                "value": "93t3j-employment-id-9suej43",
                "type": "path",
                "description": "Employment ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Shows all the company structure nodes of an employment.\n\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage company resources (`company_admin`) | View company structure (`company_structure:read`) | - |\n"
        }
      ]
    }
  ],
  "bundled": true
}