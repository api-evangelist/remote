{
  "opencollection": "1.0.0",
  "info": {
    "name": "Remote Address Details Pricing Plan API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/auth/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Pricing Plan",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Update pricing plan details",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://gateway.remote.com/v2/employments/:employment_id/pricing-plan-details",
            "params": [
              {
                "name": "employment_id",
                "value": "93t3j-employment-id-9suej43",
                "type": "path",
                "description": "Employment ID"
              },
              {
                "name": "pricing_plan_details_json_schema_version",
                "value": "1",
                "type": "query",
                "description": "Version of the pricing_plan_details form schema"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates the pricing plan for an employment. The frequency determines how often Remote bills the\nemployer for management fees. Annual billing typically offers a discount.\n\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage employments (`employments`) | - | Manage employments (`employment:write`) |\n"
        }
      ]
    }
  ],
  "bundled": true
}