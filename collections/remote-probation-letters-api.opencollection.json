{
  "opencollection": "1.0.0",
  "info": {
    "name": "Remote Address Details Probation Letters API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/auth/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Probation Letters",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Show probation completion letter",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/probation-completion-letter/:id",
            "params": [
              {
                "name": "id",
                "value": "93t3j-probation_completion_letter_id-9suej43",
                "type": "path",
                "description": "probation completion letter ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Show a single probation completion letter.\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage employment documents (`employment_documents`) | View probation documents (`probation_document:read`) | Manage probation documents (`probation_document:write`) |\n"
        },
        {
          "info": {
            "name": "Create probation completion letter",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://gateway.remote.com/v1/probation-completion-letter",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new probation completion letter request.\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage employment documents (`employment_documents`) | - | Manage probation documents (`probation_document:write`) |\n"
        }
      ]
    }
  ],
  "bundled": true
}