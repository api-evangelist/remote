{
  "opencollection": "1.0.0",
  "info": {
    "name": "Remote Address Details SCIM API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/auth/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "SCIM",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get user by ID via SCIM v2.0",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/scim/v2/Users/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "User ID (slug)"
              }
            ]
          },
          "docs": "Retrieves a single user for the authenticated company by user ID"
        },
        {
          "info": {
            "name": "List users via SCIM v2.0",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/scim/v2/Users",
            "params": [
              {
                "name": "startIndex",
                "value": "1",
                "type": "query",
                "description": "1-based index of the first result"
              },
              {
                "name": "count",
                "value": "50",
                "type": "query",
                "description": "Maximum number of results per page"
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Filter expression for attributes (supports eq, ne, co, sw, ew, pr, lt, le, gt, ge)"
              }
            ]
          },
          "docs": "Retrieves a list of users for the authenticated company following SCIM 2.0 standard"
        },
        {
          "info": {
            "name": "List groups via SCIM v2.0",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/scim/v2/Groups",
            "params": [
              {
                "name": "startIndex",
                "value": "1",
                "type": "query",
                "description": "1-based index of the first result"
              },
              {
                "name": "count",
                "value": "50",
                "type": "query",
                "description": "Maximum number of results per page"
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Filter expression for attributes (supports eq, ne, co, sw, ew, pr, lt, le, gt, ge)"
              }
            ]
          },
          "docs": "Retrieves a list of groups (departments) for the authenticated company following SCIM 2.0 standard"
        },
        {
          "info": {
            "name": "Get group by ID via SCIM v2.0",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/scim/v2/Groups/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Group ID (slug)"
              }
            ]
          },
          "docs": "Retrieves a single group (department) for the authenticated company by group ID"
        }
      ]
    }
  ],
  "bundled": true
}