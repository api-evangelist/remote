{
  "opencollection": "1.0.0",
  "info": {
    "name": "Remote Address Details Test Schema API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/auth/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Test Schema",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a mock JSON Schema",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/test-schema",
            "params": [
              {
                "name": "json_schema_version",
                "value": "1",
                "type": "query",
                "description": "Version of the form schema"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/auth/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get a mock JSON Schema for testing purposes"
        }
      ]
    }
  ],
  "bundled": true
}