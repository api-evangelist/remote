{
  "opencollection": "1.0.0",
  "info": {
    "name": "Remote Address Details Webhook Events API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/auth/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhook Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Webhook Events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/webhook-events",
            "params": [
              {
                "name": "event_type",
                "value": "timesheet.created",
                "type": "query",
                "description": "Filter by webhook event type"
              },
              {
                "name": "successfully_delivered",
                "value": "true",
                "type": "query",
                "description": "Filter by delivery status (true = 200, false = 4xx/5xx)"
              },
              {
                "name": "company_id",
                "value": "123e4567-e89b-12d3-a456-426614174000",
                "type": "query",
                "description": "Filter by company ID"
              },
              {
                "name": "before",
                "value": "2025-01-01T00:00:00Z",
                "type": "query",
                "description": "Filter by date before (ISO 8601 format)"
              },
              {
                "name": "after",
                "value": "2025-01-01T00:00:00Z",
                "type": "query",
                "description": "Filter by date after (ISO 8601 format)"
              },
              {
                "name": "order",
                "value": "asc",
                "type": "query",
                "description": "Sort order"
              },
              {
                "name": "sort_by",
                "value": "first_triggered_at",
                "type": "query",
                "description": "Field to sort by"
              },
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Starts fetching records after the given page"
              },
              {
                "name": "page_size",
                "value": "20",
                "type": "query",
                "description": "Number of items per page"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/auth/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "List all webhook events\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage company resources (`company_admin`) | View webhooks (`webhook:read`) | Manage webhooks (`webhook:write`) |\n"
        },
        {
          "info": {
            "name": "Replay Webhook Events",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://gateway.remote.com/v1/webhook-events/replay",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/auth/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Replay webhook events\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage company resources (`company_admin`) | - | Manage webhooks (`webhook:write`) |\n"
        }
      ]
    }
  ],
  "bundled": true
}