{
  "opencollection": "1.0.0",
  "info": {
    "name": "Remote Address Details Webhooks API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/auth/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Update a Webhook Callback",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://gateway.remote.com/v1/webhook-callbacks/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Webhook Callback ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update a callback previously registered for webhooks\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage company resources (`company_admin`) | - | Manage webhooks (`webhook:write`) |\n"
        },
        {
          "info": {
            "name": "Delete a Webhook Callback",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://gateway.remote.com/v1/webhook-callbacks/:id",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer <COMPANY-SCOPED ACCESS TOKEN>"
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Webhook Callback ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a callback previously registered for webhooks\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage company resources (`company_admin`) | - | Manage webhooks (`webhook:write`) |\n"
        },
        {
          "info": {
            "name": "Create a Webhook Callback",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://gateway.remote.com/v1/webhook-callbacks",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer <ANY ACCESS TOKEN>"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Register a callback to be used for webhooks\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage company resources (`company_admin`) | - | Manage webhooks (`webhook:write`) |\n"
        },
        {
          "info": {
            "name": "List Webhook Callbacks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/companies/:company_id/webhook-callbacks",
            "params": [
              {
                "name": "company_id",
                "value": "d2091b1e-b1a4-437a-91ea-2809ffbb6d59",
                "type": "path",
                "description": "Company ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List callbacks for a given company\n\n## Scopes\n\n| Category | Read only Scope | Write only Scope (read access implicit) |\n|---|---|---|\n| Manage company resources (`company_admin`) | View webhooks (`webhook:read`) | Manage webhooks (`webhook:write`) |\n"
        }
      ]
    }
  ],
  "bundled": true
}